{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omacal",
  "mainBinaryName": "omacal",
  "version": "1.8.0",
  "identifier": "com.omacal.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmaCal",
        "visible": false,
        "width": 1280,
        "height": 800,
        "titleBarStyle": "Overlay",
        "zoomHotkeysEnabled": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "icu-tz/*.res"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/linux/omacal.desktop",
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/omacal.svg": "icons/icon.svg"
        }
      },
      "rpm": {
        "desktopTemplate": "../packaging/linux/omacal.desktop",
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/omacal.svg": "icons/icon.svg"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/omacal.svg": "icons/icon.svg"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzRDQ1OUVFOEE1NTdDRgpSV1RQVjZYb25rVTlCbDlYQWxZTW5IV2pSc0h1eVN5dUU3ZGFQWDZDdXArNXFVeU9CdWV0S2NkMAo=",
      "endpoints": [
        "https://github.com/x3me/omacal/releases/latest/download/latest.json"
      ]
    }
  }
}
